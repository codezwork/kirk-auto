---
import Layout from '../layouts/Layout.astro';
import VehicleCard from '../components/VehicleCard.astro';
import { VEHICLES } from '../data/vehicles';

const truckInventory = VEHICLES.filter(v => v.bodyType === 'truck');
---

<Layout
  title="Used & Lifted Trucks for Sale in BC | F-150, Ram, Silverado | Kirk Auto"
  description="Looking for dependable cheap trucks or lifted 4x4 trucks in Metro Vancouver & Fraser Valley? All-in pricing, 4x4 capability, and bad credit truck financing with Kirk."
>
  <div class="seo-landing-page">
    <header class="landing-hero">
      <div class="container hero-inner">
        <span class="badge-amber">BC 4x4 & Work Trucks</span>
        <h1 class="landing-title font-heading">
          Used & lifted trucks for sale in BC. <span class="highlight">All-in total pricing.</span>
        </h1>
        <p class="landing-lead">
          From job-ready half-ton workhorses to 3-inch lifted 4x4 rigs ready for the Fraser Valley backroads. Inspected, BC safety certified, and backed by straightforward financing options regardless of credit history.
        </p>

        <div class="hero-actions">
          <a href="/pre-approval?situation=truck" class="btn btn-primary btn-lg">
            Get Pre-Approved for a Truck →
          </a>
          <a href="sms:+17788882093?body=Hi%20Kirk%2C%20what%20trucks%20do%20you%20currently%20have%20in%20stock%3F" class="btn btn-outline-white btn-lg">
            Text Kirk About Trucks
          </a>
        </div>
      </div>
    </header>

    <!-- Why Buy Trucks from Kirk -->
    <section class="truck-perks-section">
      <div class="container">
        <div class="perks-grid">
          <div class="perk-box card">
            <h3 class="perk-head font-heading">Tested for BC Backroads</h3>
            <p class="perk-text">4x4 transfer cases, suspension, brake rotors, and all-terrain tires are inspected by certified technicians before any truck is listed.</p>
          </div>
          <div class="perk-box card">
            <h3 class="perk-head font-heading">No Wild Dealer Markups</h3>
            <p class="perk-text">Franchise truck dealers love slapping on $2,500 in bogus "accessories and prep". Our listed price is the full price. Period.</p>
          </div>
          <div class="perk-box card">
            <h3 class="perk-head font-heading">Trades & Contractors Welcome</h3>
            <p class="perk-text">Need a truck for your framing, roofing, landscaping, or plumbing business? We work with commercial and gig-friendly lenders.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Truck Inventory Grid -->
    <section class="trucks-grid-section">
      <div class="container">
        <div class="section-title-wrap">
          <span class="badge-green">Current Truck Stock</span>
          <h2 class="section-heading font-heading">Available Trucks in Metro Vancouver & Valley</h2>
          <p class="section-sub">Every truck comes with verified Carfax, complete service history, and doorstep delivery.</p>
        </div>

        <div class="vehicles-grid">
          {truckInventory.map(truck => (
            <VehicleCard vehicle={truck} />
          ))}
        </div>
      </div>
    </section>

    <!-- Custom Truck Request Section -->
    <section class="custom-truck-section">
      <div class="container text-center">
        <div class="custom-truck-card card">
          <span class="badge-amber">Custom Sourcing</span>
          <h2 class="cta-banner-title font-heading">Looking for a specific F-150, Tacoma, or lifted diesel?</h2>
          <p class="cta-banner-lead">
            Kirk has dealer auction access across Western Canada and regularly sources clean trucks to client specifications. Text Kirk your target year, model, and budget.
          </p>
          <a href="sms:+17788882093?body=Hi%20Kirk%2C%20I'm%20looking%20for%20a%20specific%20truck%3A%20" class="btn btn-primary btn-lg">
            Text Kirk What Truck You Need
          </a>
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  .seo-landing-page {
    padding-bottom: 72px;
  }

  .landing-hero {
    background-color: var(--dark-base);
    color: var(--text-inverse);
    padding: 64px 0 72px;
    border-bottom: 1px solid var(--border-dark);
  }

  .hero-inner {
    max-width: 820px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .landing-title {
    font-size: clamp(38px, 6vw, 58px);
    line-height: 1.05;
  }

  .highlight {
    color: var(--amber);
  }

  .landing-lead {
    font-size: 19px;
    line-height: 1.6;
    color: #CBD5E1;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 10px;
  }

  /* Truck Perks */
  .truck-perks-section {
    padding: 48px 0;
    background: #FAF8F5;
    border-bottom: 1px solid var(--border-light);
  }

  .perks-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 20px;
  }

  .perk-box {
    padding: 24px;
    background: #FFFFFF;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .perk-head {
    font-size: 20px;
    color: var(--text-main);
  }

  .perk-text {
    font-size: 14px;
    color: var(--text-muted);
    line-height: 1.5;
  }

  /* Trucks Grid */
  .trucks-grid-section {
    padding: 64px 0;
  }

  .section-title-wrap {
    margin-bottom: 32px;
  }

  .section-heading {
    font-size: clamp(32px, 5vw, 44px);
    margin-top: 4px;
  }

  .section-sub {
    font-size: 17px;
    color: var(--text-muted);
    max-width: 620px;
    margin: 6px 0 0;
  }

  .vehicles-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 24px;
  }

  /* Custom Truck */
  .custom-truck-section {
    padding: 40px 0 64px;
  }

  .custom-truck-card {
    padding: 48px 24px;
    background: var(--dark-base);
    color: #FFFFFF;
    max-width: 820px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }

  .cta-banner-title {
    font-size: clamp(28px, 4.5vw, 40px);
    color: #FFFFFF;
  }

  .cta-banner-lead {
    font-size: 17px;
    color: #CBD5E1;
    max-width: 600px;
    line-height: 1.55;
  }
</style>
