---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Contact Kirk Auto | Call, Text, or WhatsApp | Metro Vancouver, BC"
  description="Get in touch directly with Kirk. Call or text (778) 888-2093 or chat on WhatsApp. Licensed BC motor dealer serving Metro Vancouver and the Fraser Valley."
>
  <div class="contact-page container">
    <div class="contact-intro text-center">
      <span class="badge-amber">Direct Owner Access</span>
      <h1 class="page-title font-heading">Let's Talk About Your Next Vehicle</h1>
      <p class="page-subtitle">
        No switchboards, no call centers, and no commissioned salespeople. When you reach out here, you communicate directly with Kirk.
      </p>
    </div>

    <div class="contact-layout">
      <!-- Left: Direct Channels & Hours -->
      <div class="channels-column">
        <!-- Direct Quick Connect Cards -->
        <div class="channel-card card">
          <div class="channel-icon-wrap phone">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.5c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"></path>
            </svg>
          </div>
          <div class="channel-info">
            <span class="channel-name">Call or Text Kirk</span>
            <a href="tel:+17788882093" class="channel-main-link font-heading">(778) 888-2093</a>
            <span class="channel-sub">Texts answered in ~15 minutes during operating hours</span>
          </div>
          <a href="sms:+17788882093?body=Hi%20Kirk%2C%20I'm%20reaching%20out%20from%20your%20website" class="btn btn-primary btn-sm">
            Text Kirk Now
          </a>
        </div>

        <div class="channel-card card">
          <div class="channel-icon-wrap whatsapp">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 12a8.5 8.5 0 0 1-12.6 7.4L3 21l1.6-5.2A8.5 8.5 0 1 1 21 12z"></path>
            </svg>
          </div>
          <div class="channel-info">
            <span class="channel-name">WhatsApp Chat</span>
            <span class="channel-main-text font-heading">Instant Messaging</span>
            <span class="channel-sub">Great for video walkarounds and photo sharing</span>
          </div>
          <a href="https://wa.me/17788882093?text=Hi%20Kirk%2C%20I%20have%20a%20question%20about%20a%20vehicle" target="_blank" rel="noopener noreferrer" class="btn btn-outline btn-sm">
            Open WhatsApp
          </a>
        </div>

        <!-- Hours & Service Area Details -->
        <div class="hours-card card">
          <h3 class="hours-heading font-heading">Hours & Appointments</h3>
          <div class="hours-list">
            <div class="hour-row">
              <span>Monday – Friday:</span>
              <strong>9:00 AM – 7:00 PM</strong>
            </div>
            <div class="hour-row">
              <span>Saturday:</span>
              <strong>9:00 AM – 6:00 PM</strong>
            </div>
            <div class="hour-row">
              <span>Sunday:</span>
              <strong>By Appointment Only</strong>
            </div>
          </div>

          <div class="service-area-box">
            <strong class="area-title">Doorstep Delivery Service Area:</strong>
            <p class="area-text">
              We deliver vehicles directly to driveways across Surrey, Vancouver, Langley, Abbotsford, Burnaby, Richmond, Coquitlam, Mission, Chilliwack, and Maple Ridge.
            </p>
          </div>

          <div class="dealer-license-box">
            <strong>Licensed BC Motor Dealer #[XXXXX]</strong>
            <span>Vehicle Sales Authority of British Columbia (VSA)</span>
          </div>
        </div>
      </div>

      <!-- Right: Message Form -->
      <div class="form-column">
        <div class="contact-form-card card">
          <h2 class="form-title font-heading">Send Kirk a Message</h2>
          <p class="form-desc">Fill out this quick note and Kirk will reply directly by text or email.</p>

          <form id="contact-form" class="direct-form" onsubmit="event.preventDefault();">
            <div class="form-group">
              <label for="contact-name" class="form-label">Your Name *</label>
              <input type="text" id="contact-name" name="name" required class="form-input" placeholder="e.g. Jaspreet Kaur" />
            </div>

            <div class="form-group">
              <label for="contact-phone" class="form-label">Phone Number (for SMS reply) *</label>
              <input type="tel" id="contact-phone" name="phone" required class="form-input" placeholder="(778) 888-2093" />
            </div>

            <div class="form-group">
              <label for="contact-email" class="form-label">Email Address *</label>
              <input type="email" id="contact-email" name="email" required class="form-input" placeholder="name@example.com" />
            </div>

            <div class="form-group">
              <label for="contact-interest" class="form-label">What can Kirk help you with?</label>
              <select id="contact-interest" name="interest" class="form-select">
                <option value="financing">General Financing / Pre-Approval Inquiry</option>
                <option value="vehicle">Inquiring about a specific vehicle in stock</option>
                <option value="source">I want Kirk to source a specific car or truck</option>
                <option value="trade">Trade-in appraisal question</option>
                <option value="other">Other general question</option>
              </select>
            </div>

            <div class="form-group">
              <label for="contact-message" class="form-label">Your Message</label>
              <textarea id="contact-message" name="message" rows="4" class="form-textarea" placeholder="Tell Kirk about your timeline, vehicle needs, or situation..."></textarea>
            </div>

            <button type="submit" class="btn btn-primary btn-lg full-btn" id="contact-submit-btn">
              Send Message to Kirk →
            </button>

            <!-- Success note -->
            <div class="contact-success" id="contact-success" style="display: none;">
              <strong>Message Sent!</strong>
              <p>Kirk has received your note and will get back to you promptly.</p>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  function setupContact() {
    const submitBtn = document.getElementById('contact-submit-btn');
    const successBox = document.getElementById('contact-success');
    const form = document.getElementById('contact-form');

    if (submitBtn && form) {
      submitBtn.addEventListener('click', () => {
        const required = form.querySelectorAll<HTMLInputElement>('[required]');
        let valid = true;
        required.forEach(inp => {
          if (!inp.value.trim()) valid = false;
        });

        if (valid && successBox) {
          successBox.style.display = 'block';
          submitBtn.style.display = 'none';
        }
      });
    }
  }

  setupContact();
  document.addEventListener('astro:page-load', setupContact);
</script>

<style>
  .contact-page {
    padding-top: 48px;
    padding-bottom: 80px;
  }

  .contact-intro {
    margin-bottom: 40px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }

  .text-center {
    text-align: center;
  }

  .page-title {
    font-size: clamp(34px, 5.5vw, 52px);
  }

  .page-subtitle {
    font-size: 18px;
    color: var(--text-muted);
    max-width: 640px;
    line-height: 1.5;
  }

  .contact-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
  }

  @media (min-width: 900px) {
    .contact-layout {
      grid-template-columns: 1fr 1.2fr;
    }
  }

  .channels-column {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .channel-card {
    padding: 24px;
    background: #FFFFFF;
    display: flex;
    align-items: center;
    gap: 18px;
  }

  .channel-icon-wrap {
    width: 52px;
    height: 52px;
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .channel-icon-wrap.phone {
    background: var(--accent-light);
    color: var(--accent);
  }

  .channel-icon-wrap.whatsapp {
    background: #DCFCE7;
    color: #15803D;
  }

  .channel-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
    flex-grow: 1;
  }

  .channel-name {
    font-size: 13px;
    font-weight: 700;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .channel-main-link {
    font-size: 26px;
    font-weight: 800;
    color: var(--dark-base);
    line-height: 1.1;
  }

  .channel-main-text {
    font-size: 22px;
    font-weight: 700;
    color: var(--dark-base);
  }

  .channel-sub {
    font-size: 12px;
    color: var(--text-muted);
  }

  .hours-card {
    padding: 28px;
    background: #FAF8F5;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .hours-heading {
    font-size: 22px;
  }

  .hours-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 14px;
  }

  .hour-row {
    display: flex;
    justify-content: space-between;
    padding-bottom: 6px;
    border-bottom: 1px dashed var(--border-light);
  }

  .service-area-box {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding-top: 10px;
    border-top: 1px solid var(--border-light);
  }

  .area-title {
    font-size: 14px;
    color: var(--text-main);
  }

  .area-text {
    font-size: 13px;
    color: var(--text-muted);
    line-height: 1.45;
  }

  .dealer-license-box {
    display: flex;
    flex-direction: column;
    background: #FFFFFF;
    padding: 12px 14px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-light);
    font-size: 13px;
    color: var(--text-muted);
  }

  .dealer-license-box strong {
    color: var(--accent);
  }

  /* Right Form */
  .contact-form-card {
    padding: 36px;
    background: #FFFFFF;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .form-title {
    font-size: 30px;
  }

  .form-desc {
    font-size: 15px;
    color: var(--text-muted);
  }

  .direct-form {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-top: 8px;
  }

  .full-btn {
    width: 100%;
  }

  .contact-success {
    background: var(--accent-light);
    padding: 16px;
    border-radius: var(--radius-sm);
    color: var(--accent);
    text-align: center;
    font-size: 14px;
    line-height: 1.4;
  }
</style>
