---
import Layout from '../layouts/Layout.astro';
import VehicleCard from '../components/VehicleCard.astro';
import { VEHICLES } from '../data/vehicles';

const starterCars = VEHICLES.filter(v => v.price <= 20000).slice(0, 3);
---

<Layout
  title="First Time Car Buyer With No Credit History in BC | Kirk Auto"
  description="Buying your first vehicle in British Columbia with zero credit history? Get approved without needing an impossible co-signer. Clean title cars under $20k delivered to your door."
>
  <div class="seo-landing-page">
    <header class="landing-hero">
      <div class="container hero-inner">
        <span class="badge-amber">First-Time Buyers in BC</span>
        <h1 class="landing-title font-heading">
          No credit history? <span class="highlight">Get your first car without an impossible co-signer.</span>
        </h1>
        <p class="landing-lead">
          Just starting your career or working your first trade job in British Columbia? Having no credit history shouldn't stop you from getting to work. Kirk works with first-time buyer finance programs that approve you based on employment.
        </p>

        <div class="hero-actions">
          <a href="/pre-approval?situation=first" class="btn btn-primary btn-lg">
            First Car Pre-Approval →
          </a>
          <a href="sms:+17788882093?body=Hi%20Kirk%2C%20I'm%20looking%20for%20my%20first%20car%20and%20have%20no%20credit%20history" class="btn btn-outline-white btn-lg">
            Text Kirk for Advice
          </a>
        </div>
      </div>
    </header>

    <!-- 3 Steps for First Time Buyers -->
    <section class="steps-section">
      <div class="container">
        <div class="section-title-wrap text-center">
          <span class="badge-green">How It Works</span>
          <h2 class="section-heading font-heading">3 Steps to Buying Your First Car in BC</h2>
        </div>

        <div class="steps-grid">
          <div class="step-card card">
            <span class="step-badge font-heading">Step 1</span>
            <h3 class="step-title">Show Proof of Work</h3>
            <p class="step-desc">
              All Canadian first-time buyer lenders require is that you have full-time or consistent part-time employment (3+ months on the job with verifiable paystubs).
            </p>
          </div>

          <div class="step-card card">
            <span class="step-badge font-heading">Step 2</span>
            <h3 class="step-title">Pick a Budget You Can Handle</h3>
            <p class="step-desc">
              We look at vehicles priced between $12,000 and $20,000 with reasonable insurance rates so your monthly car payment never puts you in financial stress.
            </p>
          </div>

          <div class="step-card card">
            <span class="step-badge font-heading">Step 3</span>
            <h3 class="step-title">Build a Strong Credit Score</h3>
            <p class="step-desc">
              Every on-time bi-weekly payment builds your credit file. In 12 to 24 months, you'll have a 700+ credit score that unlocks lower mortgage and credit card rates in Canada.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Starter Vehicles -->
    <section class="starter-cars-section">
      <div class="container">
        <div class="section-title-wrap">
          <span class="badge-amber">Reliable Starter Vehicles</span>
          <h2 class="section-heading font-heading">Affordable, Easy-to-Insure Cars Under $20,000</h2>
          <p class="section-sub">Low ICBC insurance brackets, great gas mileage, and reliable Japanese & domestic engineering.</p>
        </div>

        <div class="vehicles-grid">
          {starterCars.map(v => (
            <VehicleCard vehicle={v} />
          ))}
        </div>
      </div>
    </section>

    <!-- CTA Banner -->
    <section class="cta-banner">
      <div class="container text-center">
        <h2 class="cta-banner-title font-heading">Ready to get on the road independently?</h2>
        <p class="cta-banner-lead">Ask Kirk questions over text before doing anything. No pressure, ever.</p>
        <div class="banner-buttons">
          <a href="/pre-approval?situation=first" class="btn btn-primary btn-lg">Start First Car Pre-Approval →</a>
          <a href="sms:+17788882093?body=Hi%20Kirk%2C%20what%20cars%20do%20you%20recommend%20for%20a%20first%20time%20buyer%3F" class="btn btn-outline-white btn-lg">Text Kirk Directly</a>
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  .seo-landing-page {
    padding-bottom: 72px;
  }

  .landing-hero {
    background-color: var(--dark-base);
    color: var(--text-inverse);
    padding: 64px 0 72px;
    border-bottom: 1px solid var(--border-dark);
  }

  .hero-inner {
    max-width: 820px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .landing-title {
    font-size: clamp(38px, 6vw, 58px);
    line-height: 1.05;
  }

  .highlight {
    color: var(--amber);
  }

  .landing-lead {
    font-size: 19px;
    line-height: 1.6;
    color: #CBD5E1;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 10px;
  }

  /* Steps */
  .steps-section {
    padding: 72px 0;
    background: #FAF8F5;
  }

  .section-title-wrap {
    margin-bottom: 40px;
  }

  .text-center {
    text-align: center;
  }

  .section-heading {
    font-size: clamp(32px, 5vw, 44px);
    margin-top: 4px;
  }

  .section-sub {
    font-size: 17px;
    color: var(--text-muted);
    max-width: 620px;
    margin: 8px 0 0;
  }

  .steps-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 24px;
  }

  .step-card {
    padding: 32px 24px;
    background: #FFFFFF;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .step-badge {
    font-size: 24px;
    font-weight: 800;
    color: var(--accent);
  }

  .step-title {
    font-size: 20px;
    color: var(--text-main);
  }

  .step-desc {
    font-size: 15px;
    color: var(--text-muted);
    line-height: 1.55;
  }

  /* Cars */
  .starter-cars-section {
    padding: 72px 0;
  }

  .vehicles-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 24px;
    margin-top: 32px;
  }

  /* CTA Banner */
  .cta-banner {
    background-color: var(--dark-base);
    color: var(--text-inverse);
    padding: 64px 0;
  }

  .cta-banner-title {
    font-size: clamp(34px, 5vw, 48px);
  }

  .cta-banner-lead {
    font-size: 18px;
    color: #CBD5E1;
    margin: 10px auto 24px;
  }

  .banner-buttons {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 14px;
  }
</style>
