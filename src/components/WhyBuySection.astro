---
const pillars = [
  {
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>`,
    title: 'All-In Transparent Pricing',
    description: 'Every dealer doc fee is already included in the price tag. Only provincial/federal taxes are added at checkout. No surprise add-ons.'
  },
  {
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="8.5" cy="7" r="4"></circle><line x1="20" y1="8" x2="20" y2="14"></line><line x1="23" y1="11" x2="17" y2="11"></line></svg>`,
    title: 'Approvals for Every Credit Situation',
    description: "New to Canada, rebuilding after collections, or working gig economy: Kirk works with 20+ Canadian lenders who don't just judge your score."
  },
  {
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>`,
    title: 'Doorstep Delivery in BC',
    description: 'Browse online, get your pre-approval locked in, review paperwork electronically, and Kirk delivers the vehicle right to your home in Metro Vancouver or Fraser Valley.'
  },
  {
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>`,
    title: 'You Deal With the Owner',
    description: 'No commissioned sales games or endless finance managers. You deal with Kirk directly from your first text message to your keys in hand.'
  }
];
---

<section class="why-buy-section">
  <div class="container">
    <div class="why-grid">
      {pillars.map((item) => (
        <div class="why-item">
          <div class="why-icon" set:html={item.icon} />
          <div class="why-content">
            <h3 class="why-title">{item.title}</h3>
            <p class="why-desc">{item.description}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .why-buy-section {
    padding: 48px 0;
    border-bottom: 1px solid var(--border-light);
    background: #FAF8F5;
  }

  .why-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 32px;
  }

  .why-item {
    display: flex;
    align-items: flex-start;
    gap: 16px;
  }

  .why-icon {
    width: 48px;
    height: 48px;
    border-radius: var(--radius-sm);
    background: var(--accent-light);
    color: var(--accent);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .why-content {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .why-title {
    font-size: 20px;
    font-weight: 700;
    color: var(--text-main);
  }

  .why-desc {
    font-size: 15px;
    color: var(--text-muted);
    line-height: 1.5;
  }
</style>
