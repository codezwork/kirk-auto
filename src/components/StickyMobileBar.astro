---

<nav class="sticky-mobile-bar" aria-label="Quick Mobile Actions">
  <div class="mobile-bar-inner">
    <!-- SMS Text Kirk -->
    <a href="sms:+17788882093?body=Hi%20Kirk%2C%20I'm%20looking%20at%20vehicles%20on%20your%20website" class="mobile-bar-btn primary">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
      </svg>
      <span>Text Kirk</span>
    </a>

    <!-- WhatsApp Chat -->
    <a href="https://wa.me/17788882093?text=Hi%20Kirk%2C%20I'm%20interested%20in%20a%20vehicle" target="_blank" rel="noopener noreferrer" class="mobile-bar-btn">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 12a8.5 8.5 0 0 1-12.6 7.4L3 21l1.6-5.2A8.5 8.5 0 1 1 21 12z"></path>
      </svg>
      <span>WhatsApp</span>
    </a>

    <!-- Phone Call -->
    <a href="tel:+17788882093" class="mobile-bar-btn">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.5c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"></path>
      </svg>
      <span>Call</span>
    </a>

    <!-- Pre-Approval -->
    <a href="/pre-approval" class="mobile-bar-btn highlight">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M9 11l3 3L22 4"></path>
        <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path>
      </svg>
      <span>Qualify</span>
    </a>
  </div>
</nav>

<style>
  .sticky-mobile-bar {
    display: block;
    position: fixed;
    bottom: 0;
    left: 0;
    width: 100%;
    height: var(--sticky-bar-height);
    background: #0B0E12;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    z-index: 999;
    padding-bottom: env(safe-area-inset-bottom, 0px);
    box-shadow: 0 -4px 16px rgba(0, 0, 0, 0.3);
  }

  @media (min-width: 768px) {
    .sticky-mobile-bar {
      display: none;
    }
  }

  .mobile-bar-inner {
    display: grid;
    grid-template-columns: 1.2fr 1fr 1fr 1fr;
    height: 100%;
    align-items: center;
    padding: 0 8px;
    gap: 6px;
  }

  .mobile-bar-btn {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 48px;
    border-radius: var(--radius-sm);
    color: #C9CED6;
    font-size: 11px;
    font-weight: 700;
    text-decoration: none;
    gap: 3px;
    transition: background 0.15s ease, color 0.15s ease;
  }

  .mobile-bar-btn svg {
    flex-shrink: 0;
  }

  .mobile-bar-btn:active {
    background: rgba(255, 255, 255, 0.08);
  }

  .mobile-bar-btn.primary {
    background-color: var(--accent);
    color: #FFFFFF;
  }

  .mobile-bar-btn.primary:active {
    background-color: var(--accent-hover);
  }

  .mobile-bar-btn.highlight {
    color: var(--amber);
  }
</style>
