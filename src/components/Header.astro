---
interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const navLinks = [
  { href: '/inventory', label: 'Inventory' },
  { href: '/pre-approval', label: 'Get Approved' },
  { href: '/about-kirk', label: 'Meet Kirk' },
  { href: '/trade-in', label: 'Trade-In' },
  { href: '/payment-calculator', label: 'Calculator' },
  { href: '/contact', label: 'Contact' },
];
---

<header class="site-header">
  <!-- Top Compliance Bar -->
  <div class="top-bar">
    <div class="container top-bar-inner">
      <div class="top-bar-item">
        <span class="compliance-badge">Licensed BC Motor Dealer</span>
        <span class="dealer-num">Dealer #[XXXXX]</span>
      </div>
      <div class="top-bar-item text-right">
        <span>Open Mon–Sat 9am–7pm</span>
        <span class="dot-divider">·</span>
        <span>Metro Vancouver & Fraser Valley Delivery</span>
      </div>
    </div>
  </div>

  <!-- Main Navigation Bar -->
  <div class="main-nav">
    <div class="container nav-inner">
      <a href="/" class="brand-logo" aria-label="Kirk Auto Home">
        <span class="logo-kirk">KIRK</span>
        <span class="logo-auto">AUTO</span>
      </a>

      <nav class="desktop-menu" aria-label="Main Navigation">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class:list={['nav-link', { active: currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href)) }]}
          >
            {link.label}
          </a>
        ))}
      </nav>

      <div class="header-actions">
        <!-- Kirk Quick Status -->
        <a href="/about-kirk" class="kirk-status" title="Learn more about Kirk">
          <div class="kirk-avatar">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
              <circle cx="12" cy="7" r="4"></circle>
            </svg>
          </div>
          <div class="kirk-info">
            <span class="kirk-name">Kirk</span>
            <span class="kirk-reply">Replies in ~15m</span>
          </div>
        </a>

        <!-- Action Buttons -->
        <a href="sms:+17788882093?body=Hi%20Kirk%2C%20I'm%20on%20your%20website%20and%20had%20a%20question" class="btn btn-primary btn-sm btn-text-kirk">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
          </svg>
          <span>Text Kirk</span>
        </a>

        <a href="https://wa.me/17788882093?text=Hi%20Kirk%2C%20I'm%20interested%20in%20a%20vehicle" target="_blank" rel="noopener noreferrer" class="icon-btn" aria-label="Chat on WhatsApp">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 12a8.5 8.5 0 0 1-12.6 7.4L3 21l1.6-5.2A8.5 8.5 0 1 1 21 12z"></path>
          </svg>
        </a>

        <a href="tel:+17788882093" class="icon-btn" aria-label="Call Kirk">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.5c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"></path>
          </svg>
        </a>
      </div>
    </div>
  </div>
</header>

<style>
  .site-header {
    width: 100%;
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .top-bar {
    background-color: var(--dark-legal);
    color: #A3ABB6;
    font-size: 13px;
    padding: 7px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .top-bar-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
  }

  .compliance-badge {
    color: #E2E8F0;
    font-weight: 600;
  }

  .dealer-num {
    color: var(--amber);
    margin-left: 6px;
    font-weight: 500;
  }

  .dot-divider {
    margin: 0 6px;
    color: #4A5568;
  }

  .main-nav {
    background-color: var(--dark-base);
    color: var(--text-inverse);
    border-bottom: 1px solid var(--border-dark);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 72px;
    gap: 20px;
  }

  .brand-logo {
    display: flex;
    align-items: baseline;
    gap: 4px;
    font-family: var(--font-heading);
    font-size: 32px;
    letter-spacing: 0.02em;
    line-height: 1;
  }

  .logo-kirk {
    font-weight: 800;
    color: #FFFFFF;
  }

  .logo-auto {
    font-weight: 700;
    color: var(--amber);
  }

  .desktop-menu {
    display: none;
    align-items: center;
    gap: 24px;
  }

  @media (min-width: 900px) {
    .desktop-menu {
      display: flex;
    }
  }

  .nav-link {
    font-size: 15px;
    font-weight: 600;
    color: #C9CED6;
    padding: 6px 0;
    position: relative;
  }

  .nav-link:hover, .nav-link.active {
    color: #FFFFFF;
  }

  .nav-link.active::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 100%;
    height: 2px;
    background-color: var(--amber);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .kirk-status {
    display: none;
    align-items: center;
    gap: 10px;
    padding: 4px 10px;
    border-radius: var(--radius-sm);
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  @media (min-width: 640px) {
    .kirk-status {
      display: flex;
    }
  }

  .kirk-avatar {
    width: 32px;
    height: 32px;
    border-radius: var(--radius-full);
    background: #2D3748;
    color: var(--amber);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .kirk-info {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }

  .kirk-name {
    font-size: 13px;
    font-weight: 700;
    color: #FFFFFF;
  }

  .kirk-reply {
    font-size: 11px;
    color: #A0AEC0;
  }

  .icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--border-dark);
    border-radius: var(--radius-sm);
    color: var(--text-inverse);
    transition: all 0.15s ease;
  }

  .icon-btn:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.2);
  }

  @media (max-width: 480px) {
    .btn-text-kirk span {
      display: none;
    }
    .btn-text-kirk {
      padding: 0 12px;
      min-height: 40px;
    }
  }
</style>
